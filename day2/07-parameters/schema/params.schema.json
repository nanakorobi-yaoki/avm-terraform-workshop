{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contoso.example.com/schemas/params.schema.json",
  "title": "顧客環境パラメータ",
  "description": "Terraform に渡すパラメータの定義。Excel の入力規則に相当します。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "location",
    "costCenter",
    "owner",
    "enablePrivateEndpoint",
    "network"
  ],
  "properties": {
    "location": {
      "title": "リージョン",
      "description": "リソースを配置する Azure リージョン",
      "type": "string",
      "enum": ["japaneast", "japanwest", "eastasia", "southeastasia"],
      "default": "japaneast"
    },
    "costCenter": {
      "title": "コストセンター",
      "description": "課金按分用のコードです。経理部門より払い出された値を入力してください。",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{4}$",
      "examples": ["1234-5678"]
    },
    "owner": {
      "title": "管理者メールアドレス",
      "description": "障害発生時の連絡先です。",
      "type": "string",
      "format": "email"
    },
    "enablePrivateEndpoint": {
      "title": "Private Endpoint の有効化",
      "description": "本番環境では必ず true にしてください。",
      "type": "boolean",
      "default": false
    },
    "retentionDays": {
      "title": "ログ保持日数",
      "type": "integer",
      "minimum": 30,
      "maximum": 730,
      "default": 30
    },
    "network": {
      "title": "ネットワーク構成",
      "type": "object",
      "additionalProperties": false,
      "required": ["addressSpace", "subnets"],
      "properties": {
        "addressSpace": {
          "title": "VNet アドレス空間",
          "description": "CIDR 形式。オンプレミスと重複しない範囲を指定してください。",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
          }
        },
        "subnets": {
          "title": "サブネット定義",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "addressPrefixes"],
            "properties": {
              "name": {
                "title": "サブネット名",
                "type": "string",
                "pattern": "^snet-[a-z0-9-]{1,20}$"
              },
              "addressPrefixes": {
                "title": "アドレスプレフィックス",
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
                }
              }
            }
          }
        }
      }
    },
    "additionalTags": {
      "title": "追加タグ",
      "description": "案件固有の任意タグ",
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
